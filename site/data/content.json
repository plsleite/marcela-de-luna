   "paragrafos": [
    [
     {
      "t": "Para além da representação da dança, investigo a figura feminina como presença expressiva, atravessada por forças e vulnerabilidades.",
      "b": true
     },
     {
      "t": " O gesto, a postura e a relação entre corpo e espaço tornam-se elementos de construção de uma linguagem visual que busca revelar aquilo que ultrapassa o movimento aparente."
     }
    ]
